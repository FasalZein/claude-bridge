# Claude Bridge Configuration
# Copy this file to .dev.vars and fill in your API keys

# Backend selection: "a4f" or "algion"
BACKEND=a4f

# A4F Configuration
# Get your key from A4F
A4F_API_KEY=ddc-a4f-your-key-here

# Algion Configuration
# Get your key from Algion
ALGION_API_KEY=algion_your-key-here

# User API keys (comma-separated)
# These are the keys you use in your clients (Roo Code, Claude Code, etc.)
# Generate with: echo "sk-claude-bridge-$(openssl rand -hex 16)"
VALID_API_KEYS=sk-claude-bridge-your-generated-key
