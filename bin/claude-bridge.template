#!/usr/bin/env bash

# Claude Bridge - Anthropic API Gateway for A4F
#
# SYMLINK SETUP:
#   chmod +x bin/claude-bridge
#   mkdir -p ~/.local/bin
#   ln -sf "$(pwd)/bin/claude-bridge" ~/.local/bin/claude-bridge
#   echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc
#   # Restart terminal, then run: claude-bridge

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color
BOLD='\033[1m'
DIM='\033[2m'

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ CONFIGURATION - This will be set by setup.sh                               │
# └─────────────────────────────────────────────────────────────────────────────┘
PROJECT_DIR="__PROJECT_DIR__"

# Static ASCII Art Logo
print_logo() {
    echo -e "${CYAN}"
    cat << 'EOF'
    ╔═══════════════════════════════════════════════════════════════╗
    ║                                                               ║
    ║   ██████╗██╗      █████╗ ██╗   ██╗██████╗ ███████╗           ║
    ║  ██╔════╝██║     ██╔══██╗██║   ██║██╔══██╗██╔════╝           ║
    ║  ██║     ██║     ███████║██║   ██║██║  ██║█████╗             ║
    ║  ██║     ██║     ██╔══██║██║   ██║██║  ██║██╔══╝             ║
    ║  ╚██████╗███████╗██║  ██║╚██████╔╝██████╔╝███████╗           ║
    ║   ╚═════╝╚══════╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚══════╝           ║
    ║                                                               ║
    ║  ██████╗ ██████╗ ██╗██████╗  ██████╗ ███████╗                ║
    ║  ██╔══██╗██╔══██╗██║██╔══██╗██╔════╝ ██╔════╝                ║
    ║  ██████╔╝██████╔╝██║██║  ██║██║  ███╗█████╗                  ║
    ║  ██╔══██╗██╔══██╗██║██║  ██║██║   ██║██╔══╝                  ║
    ║  ██████╔╝██║  ██║██║██████╔╝╚██████╔╝███████╗                ║
    ║  ╚═════╝ ╚═╝  ╚═╝╚═╝╚═════╝  ╚═════╝ ╚══════╝                ║
    ║                                                               ║
    ║              🌉 Anthropic API Gateway for A4F 🌉              ║
    ║                                                               ║
    ╚═══════════════════════════════════════════════════════════════╝
EOF
    echo -e "${NC}"
}

# Check if project directory exists
check_project() {
    if [ ! -d "$PROJECT_DIR" ]; then
        echo -e "${RED}✗ Error: Project directory not found${NC}"
        echo -e "${GRAY}  Expected: $PROJECT_DIR${NC}"
        exit 1
    fi
}

# Check dependencies
check_deps() {
    if ! command -v bun &> /dev/null; then
        echo -e "${RED}✗ Bun not installed. Run: curl -fsSL https://bun.sh/install | bash${NC}"
        exit 1
    fi
}

# Check .dev.vars
check_env() {
    if [ ! -f "$PROJECT_DIR/.dev.vars" ]; then
        echo -e "${RED}✗ Missing .dev.vars file${NC}"
        echo -e "${GRAY}  Create: A4F_API_KEY=xxx, VALID_API_KEYS=sk-xxx${NC}"
        exit 1
    fi
}

# Get user API key from .dev.vars
get_user_key() {
    if [ -f "$PROJECT_DIR/.dev.vars" ]; then
        grep "^VALID_API_KEYS=" "$PROJECT_DIR/.dev.vars" | cut -d'=' -f2 | cut -d',' -f1 || echo "your-user-key"
    else
        echo "your-user-key"
    fi
}

# Show connection info box
show_info() {
    echo -e "  ${CYAN}╭─────────────────────────────────────────────────────────────╮${NC}"
    echo -e "  ${CYAN}│${NC}  ${BOLD}${WHITE}🌉 Claude Bridge${NC}  [Backend: ${BLUE}A4F${NC}]                         ${CYAN}│${NC}"
    echo -e "  ${CYAN}├─────────────────────────────────────────────────────────────┤${NC}"
    echo -e "  ${CYAN}│${NC}  ${GREEN}►${NC} ${WHITE}http://localhost:4242${NC}                                   ${CYAN}│${NC}"
    echo -e "  ${CYAN}│${NC}  ${GRAY}Messages:${NC} /v1/messages  ${GRAY}Health:${NC} /health                  ${CYAN}│${NC}"
    echo -e "  ${CYAN}╰─────────────────────────────────────────────────────────────╯${NC}"
    echo
}

# Main startup sequence
main() {
    clear
    print_logo
    
    check_project
    check_deps
    check_env
    
    show_info
    
    echo -e "  ${GREEN}✨ Starting server...${NC} ${DIM}(Ctrl+C to stop)${NC}"
    echo
    
    cd "$PROJECT_DIR"
    # Use WRANGLER_LOG=error to suppress HTTP access logs (only show errors)
    exec env WRANGLER_LOG=error bun run dev
}

# Handle arguments
case "${1:-}" in
    --help|-h)
        print_logo
        echo -e "  ${BOLD}Usage:${NC} claude-bridge [options]"
        echo
        echo -e "  ${BOLD}Options:${NC}"
        echo -e "    ${CYAN}--help, -h${NC}     Show this help message"
        echo -e "    ${CYAN}--status, -s${NC}   Check if server is running"
        echo -e "    ${CYAN}--test, -t${NC}     Run a test request"
        echo
        echo -e "  ${BOLD}Examples:${NC}"
        echo -e "    claude-bridge              # Start the bridge"
        echo
        echo -e "  ${BOLD}With Claude Code:${NC}"
        local user_key=$(get_user_key)
        echo -e "    ANTHROPIC_BASE_URL=\"http://localhost:4242\" ANTHROPIC_API_KEY=\"$user_key\" claude"
        echo
        ;;
    --status|-s)
        echo -ne "  ${YELLOW}🌉${NC} Bridge status: "
        if curl -s http://localhost:4242/health > /dev/null 2>&1; then
            response=$(curl -s http://localhost:4242/health)
            echo -e "${GREEN}✓ Running${NC} [Backend: ${BOLD}A4F${NC}]"
            echo "$response" | jq . 2>/dev/null || echo "$response"
        else
            echo -e "${RED}✗ Not running${NC}"
        fi
        ;;
    --test|-t)
        echo -e "  ${CYAN}🧪 Testing...${NC}"
        local user_key=$(get_user_key)
        response=$(curl -s -X POST http://localhost:4242/v1/messages \
            -H "Content-Type: application/json" \
            -H "x-api-key: $user_key" \
            -H "anthropic-version: 2023-06-01" \
            -d '{
                "model": "claude-sonnet-4-20250514",
                "max_tokens": 50,
                "messages": [{"role": "user", "content": "Say hello in one word."}]
            }' 2>/dev/null)
        
        if [ -n "$response" ]; then
            echo -e "  ${GREEN}✓ Working!${NC}"
            echo "$response" | jq . 2>/dev/null || echo "$response"
        else
            echo -e "  ${RED}✗ Not responding. Start with: claude-bridge${NC}"
        fi
        ;;
    *)
        main
        ;;
esac