# Claude Bridge v2.0 Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# Server Configuration
# =============================================================================

# Port to run the proxy server on
SERVER_PORT=4242

# Request timeout in milliseconds (default: 5 minutes)
REQUEST_TIMEOUT=300000

# =============================================================================
# Rate Limiting
# =============================================================================

# Maximum requests per minute to primary provider (A4F) before falling back
RATE_LIMIT_RPM=10

# =============================================================================
# User Authentication
# =============================================================================

# User API keys (comma-separated)
# These are the keys you use in your clients (Claude Code, Roo Code, etc.)
# Generate with: echo "sk-claude-bridge-$(openssl rand -hex 16)"
VALID_API_KEYS=sk-claude-bridge-your-key-here

# =============================================================================
# Provider: A4F (Primary)
# =============================================================================

# A4F API Key - Get from https://a4f.co
A4F_API_KEY=ddc-a4f-your-key-here

# A4F Base URL (optional, defaults to https://api.a4f.co/v1)
A4F_BASE_URL=https://api.a4f.co/v1

# =============================================================================
# Provider: F4F (Fallback when A4F rate limit is reached)
# =============================================================================

# F4F API Key - Get from your F4F provider
F4F_API_KEY=

# F4F Base URL (optional)
F4F_BASE_URL=https://api.f4f.dev/v1

# =============================================================================
# Background Model (for Haiku and light tasks)
# =============================================================================

# Enable Gemini Flash for background models (haiku, etc.)
# When enabled, requests for haiku models will use Gemini 3 Flash instead
USE_GEMINI_FOR_BACKGROUND=true

# Background model to use (uses A4F's Gemini 3 Flash Preview by default)
# Available options:
#   - provider-3/gemini-3-flash-preview (SOTA, recommended)
#   - provider-8/gemini-3-flash
#   - provider-3/gemini-2.5-flash
BACKGROUND_MODEL=provider-3/gemini-3-flash-preview

# =============================================================================
# Direct Gemini API (optional, not needed if using A4F for Gemini)
# =============================================================================

# Gemini API Key - Get from https://makersuite.google.com/app/apikey
# Only needed if you want to use Gemini directly instead of through A4F
GEMINI_API_KEY=
